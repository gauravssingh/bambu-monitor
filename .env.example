# Application
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database
DATABASE_PATH=./data/bambu.db

# Bambu Printer (Optional environment overrides; discovery & onboarding store these in OS Keyring)
BAMBU_HOST=192.168.68.57
BAMBU_SERIAL=0309DA572602482
BAMBU_ACCESS_CODE=

# Credential Store Master Key (Optional for headless/containerized deployments)
# BAMBU_ENCRYPTION_KEY=

# Outbox Delivery (Hermes Webhook Gateway)
EVENT_ENDPOINT=http://localhost:8644/webhooks/bambu-printer
EVENT_SECRET=replace-with-the-Hermes-subscription-secret
# URL Hermes can use to fetch camera snapshots from this monitor.
BAMBU_MONITOR_PUBLIC_URL=http://localhost:8000
# Optional: when set, clients must send it as X-API-Key.
# BAMBU_MONITOR_API_TOKEN=generate-a-long-random-token

# RTSP URL for the printer camera, including credentials if required.
# A1_MINI_CAMERA_RTSP=rtsp://user:password@camera-host:554/stream1

# Hermes webhook delivery.
# EVENT_ENDPOINT=http://localhost:8644/webhooks/bambu-printer
# EVENT_SECRET=replace-with-the-Hermes-subscription-secret
