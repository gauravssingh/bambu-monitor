# Application
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database
DATABASE_PATH=./data/bambu.db

# Printer identity (used by config.yaml via ${BAMBU_HOST}/${BAMBU_SERIAL})
BAMBU_HOST=192.168.1.100
BAMBU_SERIAL=00A00EXAMPLE0000

# Printer LAN Access Code (optional env override; onboarding stores it in the OS keyring)
BAMBU_ACCESS_CODE=

# Credential Store Master Key (Optional for headless/containerized deployments)
# BAMBU_ENCRYPTION_KEY=

# Hermes webhook delivery. Generate a real secret, e.g.:
#   python -c "import secrets; print(secrets.token_hex(24))"
# The same secret must be configured in the Hermes subscription.
EVENT_ENDPOINT=http://localhost:8644/webhooks/bambu-printer
EVENT_SECRET=generate-and-paste-a-long-random-secret

# URL Hermes can use to fetch camera snapshots from this monitor.
BAMBU_MONITOR_PUBLIC_URL=http://localhost:8000

# Optional: when set, API clients must send it as X-API-Key.
# BAMBU_MONITOR_API_TOKEN=generate-a-long-random-token

# RTSP URL for the printer camera, including credentials if required.
# A1_MINI_CAMERA_RTSP=rtsp://user:password@camera-host:554/stream1
# TIMELAPSE_CAMERA_RTSP=rtsp://user:password@camera-host:554/stream1
